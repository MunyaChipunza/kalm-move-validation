{
  "name": "kalm-production-release-controls",
  "private": true,
  "version": "1.0.0",
  "description": "Reproducible validation tooling for protected KALM production releases.",
  "scripts": {
    "check:legacy-storefront": "node scripts/check-forbidden-legacy-storefront.mjs --root .",
    "release:preflight": "node tools/kalm-production-release.mjs --mode preflight",
    "release:smoke": "node tools/kalm-production-release.mjs --mode postdeploy",
    "release:verify-controls": "node tools/kalm-production-release.mjs --mode verify-controls",
    "release:test-controls": "node tools/kalm-release-control-tests.mjs",
    "release:validate-workflows": "node tools/validate-workflows.mjs",
    "payfast:test": "node --test tests/payfast/payfast-core.test.mjs",
    "payfast:security": "node scripts/check-payfast-security.mjs",
    "payfast:activate": "node scripts/activate-payfast.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^9.1.6"
  },
  "devDependencies": {
    "netlify-cli": "26.2.0",
    "playwright": "1.55.0",
    "yaml": "^2.8.1"
  }
}
